{
	"name": "@elluzion/iv-ui",
	"version": "0.1.0",
	"description": "A Svelte 5 component library with a monochrome dark design system.",
	"type": "module",
	"author": "elluzion",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/elluzion/iv-ui.git"
	},
	"homepage": "https://github.com/elluzion/iv-ui#readme",
	"bugs": {
		"url": "https://github.com/elluzion/iv-ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"component-library",
		"ui",
		"design-system"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./theme.css": "./dist/theme/theme.css",
		"./tokens.css": "./dist/theme/tokens.css",
		"./base.css": "./dist/theme/base.css",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com/",
		"access": "public"
	},
	"peerDependencies": {
		"@tabler/icons-svelte": "^3.46.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@storybook/addon-a11y": "^10.5.5",
		"@storybook/addon-docs": "^10.5.5",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-vitest": "^10.5.5",
		"@storybook/sveltekit": "^10.5.5",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.10",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.5.5",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.62.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.21",
		"storybook": "^10.5.5",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.10"
	}
}
